# Copy to .env and adjust if needed. Every variable has a safe default in config/env.ts,
# so the project runs out of the box without this file.
#
# Target application: https://practicesoftwaretesting.com (public demo store "Toolshop")
#
# NOTE ON CREDENTIALS: the suite does NOT use a shared test account. Every run
# registers its own user via the API (core/run-user.ts) — that is what makes
# parallel execution safe on a shared environment. The only static account here is
# admin, and only teardown uses it, because a user cannot delete itself (403).

# UI and API base URLs
UI_BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com

# OpenAPI document — the source of both generated types and contract tests
OPENAPI_URL=https://api.practicesoftwaretesting.com/docs

# Admin account, used ONLY by global-teardown to remove the run user.
# These are public demo credentials published by the app maintainers, not secrets.
# On a real project these belong in CI secrets and go through requireEnv().
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=welcome01

# Runtime
HEADLESS=true
WORKERS=4

# Namespaces everything this run creates. CI passes the workflow run id;
# locally it defaults to a timestamp.
# RUN_ID=

# Shown as the owner on every test in the Allure report
# ALLURE_OWNER=QA Automation

{
	"name": "playwright-ui-api-framework",
	"version": "1.0.0",
	"description": "Production-grade UI + API test automation framework: Playwright, TypeScript, POM, custom fixtures, typed API client, Allure, CI",
	"license": "MIT",
	"scripts": {
		"clean:allure": "node -e \"require('fs').rmSync('allure-results', {recursive: true, force: true})\"",
		"clean": "node -e \"['tmp','test-results','playwright-report','allure-results','allure-report','.playwright-mcp'].forEach(d => require('fs').rmSync(d, {recursive: true, force: true}))\"",
		"pretest": "npm run clean:allure",
		"test": "playwright test",
		"test:headed": "cross-env HEADLESS=false playwright test",
		"test:ui": "playwright test --ui",
		"test:smoke": "playwright test --grep @smoke",
		"test:regression": "playwright test --grep @regression",
		"test:api": "playwright test --project=api",
		"test:ui-only": "playwright test --project=ui",
		"test:demo": "playwright test --grep @demo",
		"test:green": "playwright test --grep-invert @demo",
		"api:types": "node scripts/generate-api-types.js",
		"report": "playwright show-report",
		"report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
		"lint": "eslint tests/ pages/ api/ fixtures/ utils/ data/ config/ core/ --ext .ts",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"install:browsers": "playwright install chromium"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"allure-commandline": "^2.38.1",
		"allure-playwright": "^2.15.1",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.5",
		"eslint": "^8.57.1",
		"eslint-plugin-playwright": "^2.10.1",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.2"
	}
}
